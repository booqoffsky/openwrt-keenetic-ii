/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "rt6855.dtsi"

/ {
	compatible = "zyxel,keenetic-ii", "ralink,rt6855-soc";
	model = "Zyxel Keenetic II";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
	};

	memory@20000 {
		device_type = "memory";
		reg = <0x00020000 0x07fe0000>;
	};

	chosen {
		bootargs = "console=ttyS0,57600";
	};

	leds {
		compatible = "gpio-leds";

		led_power: led-power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		button-fn {
			label = "fn";
			gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
		};

		button-reset {
			label = "reset";
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&pcie {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&pcie0 {
	wifi@0,0 {
		compatible = "pci1814,3091";
		reg = <0x00000000 0 0 0 0>;
		nvmem-cells = <&eeprom_factory_0>;
		nvmem-cell-names = "eeprom";
	};
};

&watchdog {
	status = "okay";
};

&ethernet {
	status = "okay";

	nvmem-cells = <&macaddr_factory_4>;
	nvmem-cell-names = "mac-address";

	/*
	 * The five Fast Ethernet ports sit on the SoC-internal GSW, which
	 * shares the frame-engine register window. The phandle selects the
	 * internal switch bring-up and provides its reset/clock gate; the
	 * portmap preset leaves switch port 4 — the Internet jack — as WAN
	 * and ports 0 through 3 as LAN (CPU port 6), matching the mirrored
	 * enclosure order (see 02_network), so the switch forwards from
	 * early boot, before netifd applies the swconfig configuration.
	 */
	ralink,gsw-syscon = <&pcie_reset>;
	mediatek,portmap = "llllw";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "u-config";
				reg = <0x030000 0x010000>;
				read-only;
			};

			factory: partition@40000 {
				label = "RF-EEPROM";
				reg = <0x040000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x200>;
					};

					macaddr_factory_4: macaddr@4 {
						reg = <0x4 0x6>;
					};
				};
			};

			firmware: partition@50000 {
				compatible = "openwrt,uimage", "denx,uimage";
				label = "firmware";
				reg = <0x050000 0xea0000>;
			};

			partition@ef0000 {
				label = "config";
				reg = <0xef0000 0x010000>;
				read-only;
			};

			partition@f00000 {
				label = "storage";
				reg = <0xf00000 0x0f0000>;
				read-only;
			};

			partition@ff0000 {
				label = "dump";
				reg = <0xff0000 0x010000>;
				read-only;
			};
		};
	};
};

&ohci {
	status = "okay";
};

&ehci {
	status = "okay";
};
